{
  "name": "TKRP",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/app",
  "forwardPorts": [5173, 3001],
  "portsAttributes": {
    "5173": { "label": "Vite" },
    "3001": { "label": "API" }
  },
  "postCreateCommand": "bash -c '[ -f .env ] || [ ! -f .env.example ] || cp .env.example .env'",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
