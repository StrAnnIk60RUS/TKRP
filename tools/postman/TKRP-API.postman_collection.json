        {
          "name": "POST /api/enrich — минимальный конкурент (семантическое обогащение)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "eval(pm.collectionVariables.get('tkrpTestLib') || '');",
                  "const j = pm.response.json();",
                  "pm.test('[FR-1.2] HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('[FR-1.3] request_guardrails (проверка лимитов)', () => {",
                  "  pm.expect(j).to.have.property('request_guardrails');",
                  "  pm.expect(j.request_guardrails).to.have.property('batches_count');",
                  "  pm.expect(j.request_guardrails).to.have.property('limits');",
                  "  pm.expect(j.request_guardrails.limits).to.have.property('auto_batch');",
                  "  tkrpAssertRequestId(j);",
                  "});",
                  "pm.test('[FR-1.2] success — boolean', () => pm.expect(typeof j.success).to.eql('boolean'));",
                  "if (j.success === true && j.enriched_data) {",
                  "  pm.test('[FR-1.4] engagement_rate на каждом посте (локально)', () => {",
                  "    const posts = tkrpPostsFromCompetitorsData(j.enriched_data);",
                  "    pm.expect(posts.length).to.be.above(0);",
                  "    posts.forEach((post) => {",
                  "      pm.expect(post).to.have.property('engagement_rate');",
                  "      pm.expect(Number.isFinite(Number(post.engagement_rate))).to.eql(true);",
                  "    });",
                  "  });",
                  "  pm.test('[FR-1.4] metrics_quality на постах', () => {",
                  "    const posts = tkrpPostsFromCompetitorsData(j.enriched_data);",
                  "    posts.forEach((post) => {",
                  "      if (post.metrics_quality !== undefined) {",
                  "        pm.expect(['views_based', 'interaction_proxy', 'unknown']).to.include(post.metrics_quality);",
                  "      }",
                  "    });",
                  "  });",
                  "  pm.test('[FR-1.5 / FR-1.6] metadata.batching и usage', () => {",
                  "    pm.expect(j.metadata).to.be.an('object');",
                  "    pm.expect(j.metadata).to.have.property('batching');",
                  "    pm.expect(j.metadata.batching).to.have.property('total_batches');",
                  "    if (j.usage) {",
                  "      pm.expect(j.usage).to.have.property('total_tokens');",
                  "    }",
                  "  });",
                  "  pm.test('[FR-1.6] семантические поля (topic, tone, objective)', () => {",
                  "    const posts = tkrpPostsFromCompetitorsData(j.enriched_data);",
                  "    const p = posts[0];",
                  "    pm.expect(p).to.have.property('topic');",
                  "    pm.expect(p).to.have.property('tone');",
                  "    pm.expect(p).to.have.property('objective');",
                  "    pm.expect(['inform', 'educate', 'engage', 'convert', 'retain']).to.include(p.objective);",
                  "  });",
                  "  pm.test('[FR-1.7] нормализация enriched_data', () => {",
                  "    pm.expect(j.metadata.normalized_to_content_model).to.eql(true);",
                  "    pm.expect(Array.isArray(j.enriched_data.competitors)).to.eql(true);",
                  "  });",
                  "  pm.test('[FR-2 / UC8] persistence в корпус прецедентов', () => {",
                  "    pm.expect(j).to.have.property('persistence');",
                  "  });",
                  "} else {",
                  "  pm.test('[FR-4] при отказе БЯМ — осмысленный ответ (не 5xx)', () => {",
                  "    pm.expect(pm.response.code).to.be.below(500);",
                  "  });",
                  "}",
                  "if (j.metadata?.partial_enrichment === true) {",
                  "  pm.test('[FR-1.7 / FR-4] частичное обогащение зафиксировано', () => {",
                  "    pm.expect(j.metadata.partial_enrichment).to.eql(true);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
