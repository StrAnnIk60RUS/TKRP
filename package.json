{
  "name": "it-project-promotion-app",
  "version": "1.0.0",
  "description": "Веб-приложение для автоматизации продвижения IT-проектов",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:vite\" \"npm:dev:server\"",
    "dev:vite": "vite --config apps/web/vite.config.js",
    "dev:server": "npm run dev --prefix apps/api",
    "build": "vite build --config apps/web/vite.config.js",
    "preview": "vite preview --config apps/web/vite.config.js",
    "lint": "node ./tools/scripts/lint-project.mjs",
    "test": "node --test apps/web/tests/frontend-formUtils.test.js apps/api/tests/ontologyAggregation.test.js apps/api/tests/security.test.js",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^9.2.1",
    "vite": "^5.0.0"
  }
}
