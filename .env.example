PORT=3001
APP_URL=http://localhost:5173
VITE_ENRICHMENT_API_URL=http://localhost:3001

OPENROUTER_API_KEY=your_openrouter_api_key
# Chat model id in OpenRouter form: provider/model (see https://openrouter.ai/models)
# deepseek/deepseek-v4-flash: $0.091/M input, $0.182/M output (Oct 2026). Cheap output
# suits post JSON. google/gemini-3.7-flash is stronger and several times more expensive.
AI_MODEL=deepseek/deepseek-v4-flash
# intfloat/multilingual-e5-large outputs 1024-dim vectors (matches migrations/001_initial.sql vector(1024)).
# Switching to a 1536-d or 4096-d model requires EMBEDDING_VECTOR_DIM update, a DB schema migration, and full re-embed.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Image: FLUX.2 Pro, $0.03 for the first megapixel at 1K.
IMAGE_MODEL=black-forest-labs/flux.2-pro
# Video: Veo 3.1 Lite, 720p, 4s, no audio is about $0.12 per clip ($0.03/s).
VIDEO_MODEL=google/veo-3.1-lite
VIDEO_DURATION_SEC=4
VIDEO_RESOLUTION=720p
VIDEO_GENERATE_AUDIO=false
EMBEDDING_MAX_BATCH=64
EMBEDDING_TIMEOUT_MS=60000

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_BODY_LIMIT=10mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
SERVER_API_KEY=
ADMIN_API_KEY=

PARSER_TIMEOUT_MS=120000
ML_SCRIPT_TIMEOUT_MS=180000
ML_AUTO_TRAIN_AFTER_INGESTION=true
PYTHON_BIN=python
VK_API_TOKEN=
VK_COOKIE=
LINKEDIN_COOKIE=
INSTAGRAM_COOKIE=
APIFY_API_TOKEN=
# Local-only password for the admin123 account that can use Instagram. Do not commit the value.
INSTAGRAM_PREVIEW_PASSWORD=

# PostgreSQL + pgvector (storage backend switch)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tkrp
USE_DATABASE=true
EMBEDDING_VECTOR_DIM=1024
# Explicit backend switch (pg); production defaults to pg. See docs/precedent-storage.md
PRECEDENT_STORAGE=pg
APP_ENV=development
# Bump when EMBEDDING_MODEL changes; stored records carry embedding_model_version
EMBEDDING_MODEL_VERSION=intfloat/multilingual-e5-large

# RAG query cache (LRU, keyed by backend+modelVersion+query+filters)
RAG_CACHE_ENABLED=true
RAG_CACHE_MAX_ENTRIES=128
RAG_CACHE_TTL_MS=300000
# pgvector ANN candidate pool size (default max(200, limit*20))
RAG_ANN_CANDIDATES=200

# Reliability scoring weights (sum ~1) + calibration
RELIABILITY_WEIGHT_RETRIEVAL=0.5
RELIABILITY_WEIGHT_COMPLETENESS=0.35
RELIABILITY_WEIGHT_SOURCE_TRUST=0.15
RELIABILITY_LOG_EVERY=200
RELIABILITY_TARGET_MEAN=0.6

MAX_POSTS_PER_ENRICH_REQUEST=15
MAX_ENRICH_PAYLOAD_BYTES=180000
MAX_ENRICH_REQUEST_BYTES=2000000
MAX_ENRICH_POST_CONTENT_CHARS=4000
ENRICH_AUTO_BATCH=true
ENRICH_RETRY_ON_INVALID=true

# Semantic enrichment gate: default ON in development, OFF in production (APP_ENV/NODE_ENV).
# Explicit true/false here overrides the environment-based default.
SEMANTIC_ENRICHMENT_ENABLED=
# LLM response cache: sha256-keyed (system+user prompt+options); optional disk persistence.
SEMANTIC_ENRICHMENT_CACHE_FILE=
SEMANTIC_ENRICHMENT_CACHE_MAX_ENTRIES=200
# Shared LLM cache (used by all LLM call sites; falls back to SEMANTIC_ENRICHMENT_* above).
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_MS=0
LLM_CACHE_MAX_ENTRIES=200
LLM_CACHE_FILE=
# Max LLM API calls per rolling minute (0 = no limit).
SEMANTIC_ENRICH_RATE_LIMIT_PER_MIN=0

# Pipeline stage error handling: bounded retries with exponential backoff for
# retryable (transport/5xx/timeout) failures; validation errors are not retried.
PIPELINE_ERROR_RETRY_ATTEMPTS=1
PIPELINE_ERROR_RETRY_BASE_DELAY_MS=2000

# Ontology enrichment (LLM-derived ML features): default OFF; keep train/predict consistent.
ONTOLOGY_LLM_ENRICHMENT_MODE=off
ONTOLOGY_SCORING_ROLLOUT_PERCENT=0

# ML feature set versioning: JS builders emit FEATURE_SET_VERSION (v2);
# Python validates artifacts against EXPECTED_FEATURE_SET_VERSION.
EXPECTED_FEATURE_SET_VERSION=v2
# Max saved plan snapshots (GA-optimized) included in plan-model training (0 = off).
ML_PLAN_SNAPSHOT_TRAINING_LIMIT=20

# Async job queue (POST /api/plan/optimize:async; sync endpoint unchanged).
# In-process queue: max concurrent running jobs, TTL for finished-job results,
# max retained jobs (LRU sweep).
JOB_QUEUE_MAX_CONCURRENCY=1
JOB_RESULT_TTL_MS=3600000
JOB_QUEUE_MAX_RETAINED=200

# Plan snapshots: payload cap and TTL (default 30 days).
PLAN_SNAPSHOT_MAX_PAYLOAD_BYTES=2000000
PLAN_SNAPSHOT_TTL_MS=2592000000

# Python JSON worker resilience (relevance prediction bridge):
# per-request timeout, retry count, exponential backoff base,
# circuit breaker (open after N consecutive failures, cooldown before half-open).
PYWORKER_REQUEST_TIMEOUT_MS=30000
PYWORKER_MAX_RETRIES=2
PYWORKER_BACKOFF_BASE_MS=500
PYWORKER_BREAKER_MAX_FAILURES=3
PYWORKER_BREAKER_COOLDOWN_MS=30000